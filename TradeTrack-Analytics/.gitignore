# Regenerable artifacts — rebuild with `python analytics/scripts/run_all.py` (~30s)
datasets/tradetrack.db                      # binary warehouse, rebuilt by load_to_sql
datasets/processed/trades_clean_notebook.csv # duplicate export from the notebook
reports/images/                             # generated PNG charts
reports/ml_*.json                          # model metrics
reports/ml_*.md                            # model reports
reports/sql_analysis_results.md            # generated SQL output
reports/kpi_summary.json                   # generated KPI metrics
frontend/dashboard/data.js                 # generated data layer
frontend/dashboard/charts/                 # exported interactive charts

# The raw and cleaned CSVs ARE committed on purpose: a reviewer should be able
# to inspect the dataset without running anything.

